<</Type/EmbeddedFile/Length 817>>stream
/* SPDX-License-Identifier: MIT */
#include <pspkernel.h>
#include <pspdebug.h>

PSP_MODULE_INFO("SampleApp", 0, 1, 0);
PSP_MAIN_THREAD_ATTR(PSP_THREAD_ATTR_USER);
PSP_MAIN_THREAD_STACK_SIZE_KB(32);
PSP_HEAP_SIZE_KB(2048);

static int quit;

static int on_exit(int a, int b, void *p)
{
    (void)a; (void)b; (void)p;
    __atomic_store_n(&quit, 1, __ATOMIC_RELAXED);
    return 0;
}

int main(void)
{
    SceUID cb = sceKernelCreateCallback("SampleExit", on_exit, NULL);
    if (cb < 0 || sceKernelRegisterExitCallback(cb) < 0) {
        sceKernelExitGame();
        return 1;
    }
    pspDebugScreenInit();
    pspDebugScreenPrintf("SampleApp - User Mode\nPress HOME to exit.\n");
    while (!__atomic_load_n(&quit, __ATOMIC_RELAXED))
        sceKernelDelayThreadCB(20000);
    sceKernelExitGame();
    return 0;
}

endstream 
endobj
