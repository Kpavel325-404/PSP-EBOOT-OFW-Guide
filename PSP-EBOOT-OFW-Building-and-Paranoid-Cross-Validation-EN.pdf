<</Type/EmbeddedFile/Length 389>>stream
TARGET = SampleApp
OBJS = main.o
CFLAGS = -O2 -G0 -Wall -Wextra -Werror -ffunction-sections -fdata-sections
LDFLAGS = -Wl,--gc-sections,-Map,build/SampleApp.map
LIBS =
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
PSP_EBOOT_TITLE = SampleApp
SFOFLAGS += -s PSP_SYSTEM_VER=6.60
EXTRA_TARGETS = EBOOT.PBP
PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

endstream 
endobj
