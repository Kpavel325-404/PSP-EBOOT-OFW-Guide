<</Type/EmbeddedFile/Length 1166>>stream
#!/usr/bin/env python3
"""A conservative, bounded preflight for the pinned legacy ebootsign path."""
import os
import struct
import sys

path = sys.argv[1] if len(sys.argv) > 1 else "EBOOT.PBP"
with open(path, "rb") as f:
    total = os.fstat(f.fileno()).st_size
    header = f.read(40)
    if len(header) != 40 or header[:4] != b"\0PBP":
        raise SystemExit("Invalid PBP header")
    offsets = struct.unpack_from("<8I", header, 8)
    if offsets[0] != 40 or offsets[-1] > total:
        raise SystemExit("Invalid section bounds")
    if any(a > b for a, b in zip(offsets, offsets[1:])):
        raise SystemExit("Unordered section offsets")
    length = offsets[7] - offsets[6]
    if not 52 <= length <= 4 * 1024 * 1024:
        raise SystemExit("DATA.PSP must fit the 4 MiB input buffer")
    f.seek(offsets[6])
    data = f.read(length)
if len(data) != length:
    raise SystemExit("Short DATA.PSP read")
if data[:7] != b"\x7fELF\x01\x01\x01":
    raise SystemExit("Need ELF32 little-endian, version 1")
if struct.unpack_from("<HH", data, 16) != (0xFFA0, 8):
    raise SystemExit("Need relocatable PSP PRX for MIPS")
print("Preflight OK:", length, "bytes")

endstream 
endobj
