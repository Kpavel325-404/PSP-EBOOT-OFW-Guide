#!/usr/bin/env python3
"""Offline checks for one pinned ebootsign format, not an OFW emulator."""
import hashlib
import hmac
import re
import struct
import sys
from pathlib import Path
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.primitives.cmac import CMAC

def need(ok, message):
    if not ok:
        raise ValueError(message)

def pbp(path):
    b = Path(path).read_bytes()
    need(len(b) >= 40 and b[:4] == b"\0PBP", "PBP header")
    need(struct.unpack_from("<I", b, 4)[0] == 0x10000, "PBP version")
    o = struct.unpack_from("<8I", b, 8) + (len(b),)
    need(o[0] == 40 and all(a <= z for a, z in zip(o, o[1:])),
         "PBP bounds")
    return [b[a:z] for a, z in zip(o, o[1:])]

def source(root, filename, blob):
    b = (root / filename).read_bytes()
    prefix = b"blob " + str(len(b)).encode() + b"\0"
    need(hashlib.sha1(prefix + b).hexdigest() == blob,
         "Pinned source changed: " + filename)
    return b.decode("ascii")

def array(text, name, size):
    pattern = r"\b" + name + r"\s*\[[^]]*\]\s*=\s*\{(.*?)\};"
    m = re.search(pattern, text, re.S)
    need(m is not None, "Missing C array: " + name)
    b = bytes(int(x, 16) for x in
              re.findall(r"0x([0-9a-fA-F]{1,2})\b", m[1]))
    need(len(b) == size, "C array length: " + name)
    return b

def expected_prx(data):
    b = bytearray(data)
    need(52 <= len(b) <= 4 * 1024 * 1024, "4 MiB input bound")
    need(b[:7] == b"\x7fELF\x01\x01\x01", "ELF identity")
    need(struct.unpack_from("<HH", b, 16) == (0xFFA0, 8),
         "PRX type / MIPS machine")
    off = struct.unpack_from("<I", b, 32)[0]
    step, count = struct.unpack_from("<HH", b, 46)
    need(step == 40 and off + step * count <= len(b),
         "ELF section table")
    changed = 0
    for i in range(count):
        s = struct.unpack_from("<10I", b, off + i * step)
        start, size = s[4:6]
        if s[1] != 8:  # SHT_NOBITS has no file payload.
            need(start + size <= len(b), "ELF section bounds")
        if s[1] == 0x700000A0:
            need(size % 8 == 0, "Relocation alignment")
            for p in range(start, start + size, 8):
                info = struct.unpack_from("<I", b, p + 4)[0]
                if info & 0xFF == 7:
                    struct.pack_into("<I", b, p + 4, info & 0xFFFFFF00)
                    changed += 1
    return bytes(b), changed

def decrypt(key, data):
    ctx = Cipher(algorithms.AES(key), modes.CBC(bytes(16))).decryptor()
    return ctx.update(data) + ctx.finalize()

def check_cmac(key, data, expected):
    ctx = CMAC(algorithms.AES(key))
    ctx.update(data)
    need(hmac.compare_digest(ctx.finalize(), expected), "CMAC mismatch")

def verify(unsigned, signed, root):
    u, s = pbp(unsigned), pbp(signed)
    need(all(u[i] == s[i] for i in range(8) if i != 6),
         "Non-DATA.PSP section changed")
    crypter = source(root, "main_crypter.h",
        "49c1db30e4ae5c4c54b1340718972d4e56d56805")
    keys = source(root, "internal_keys.h",
        "905c6c2f8c722c67261f5342ecb4cdd6f85fdaed")
    header = array(crypter, "pspHeader", 0x150)
    template = array(crypter, "kirkHeader", 0x110)
    master = array(keys, "kirk1_key", 16)
    need(len(s[6]) == 0x553450, "Signed payload size")
    need(s[6][:0x150] == header, "PSP wrapper template")
    raw = template + s[6][0x150:]
    need(struct.unpack_from("<I", raw, 0x60)[0] == 1, "KIRK mode")
    size, offset = struct.unpack_from("<II", raw, 0x70)
    need((size, offset) == (0x553300, 0x80), "KIRK layout")
    aligned = (size + 15) & ~15
    end = 0x90 + offset + aligned
    need(end == len(raw), "KIRK bounds")
    decoded = decrypt(master, raw[:32])
    check_cmac(decoded[16:], raw[0x60:0x90], raw[0x20:0x30])
    check_cmac(decoded[16:], raw[0x60:end], raw[0x30:0x40])
    plain = decrypt(decoded[:16], raw[0x90 + offset:end])
    expected, changed = expected_prx(u[6])
    need(plain[:len(expected)] == expected, "Decrypted PRX mismatch")
    return {"input_bytes": len(u[6]), "signed_bytes": len(s[6]),
            "relocations_changed": changed, "offline_checks": "PASS"}

if __name__ == "__main__":
    if len(sys.argv) != 4:
        raise SystemExit("Usage: cross_validate.py unsigned.pbp signed.pbp sources")
    print(verify(sys.argv[1], sys.argv[2], Path(sys.argv[3])))

endstream 
endobj
